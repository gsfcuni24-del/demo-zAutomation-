# Copy to .env and adjust. Never commit real secrets.

# --- Application ---
ENVIRONMENT=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-dev-only-secret-key-min-32-chars
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=zautomation
POSTGRES_PASSWORD=zautomation
POSTGRES_DB=zautomation

# --- Redis (ARQ) ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# --- Object storage (S3-compatible; local dev store added in Phase 3) ---
S3_ENDPOINT_URL=
S3_BUCKET=zautomation-files
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- LLM providers (via LiteLLM) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
