</Data>
</Tag>
<Tag Name="Belt_Load_Pct" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Belt load estimate (%)]]>
</Description>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="Conveyor_Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Jam detection from photo-eye]]>
</Comment>
<Text>
<![CDATA[XIC(Jam_PE) OTE(Jam_Detected);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Jam_Detected) OTL(Jam_Alarm);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Fault_Reset_PB) XIO(Jam_Detected) OTU(Jam_Alarm);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Belt load calculation]]>
</Comment>
<Text>
<![CDATA[JSR(Speed_Calc,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Speed_Calc" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[(* Belt load scaling from line speed *)]]>
</Line>
<Line Number="1">
<![CDATA[IF Conveyor_Motor_Run THEN]]>
</Line>
<Line Number="2">
<![CDATA[    Belt_Load_Pct := Line_Speed * 4.0;]]>
</Line>
<Line Number="3">
<![CDATA[ELSE]]>
</Line>
<Line Number="4">
<![CDATA[    Belt_Load_Pct := 0.0;]]>
</Line>
<Line Number="5">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
