<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Run request seal-in with stop and E-stop permissives]]>
</Comment>
<Text>
<![CDATA[BST XIC(Start_PB) NXB XIC(Run_Request) BND XIC(Stop_PB) XIC(EStop_OK) OTE(Run_Request);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Start warning delay]]>
</Comment>
<Text>
<![CDATA[XIC(Run_Request) TON(Start_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Sound horn while start delay is timing]]>
</Comment>
<Text>
<![CDATA[XIC(Run_Request) XIO(Start_Timer.DN) OTE(Horn);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Conveyor motor: run after warning, stop on E-stop or jam]]>
</Comment>
<Text>
<![CDATA[XIC(Run_Request) XIC(Start_Timer.DN) XIC(EStop_OK) XIO(Jam_Detected) OTE(Conveyor_Motor_Run);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Conveyor" TestEdits="false" MainRoutineName="Conveyor_Logic" Disabled="false" UseAsFolder="false">
<Tags>
